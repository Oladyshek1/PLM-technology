# Пример переменных окружения для docs/bd.
# Скопируйте в .env (локально) или задайте в панели Render (в облаке).

# Строка подключения к PostgreSQL.
#   - не задана            → локальный встроенный PostgreSQL (pgserver, папка pgdata)
#   - задана               → используется эта БД (Render / Neon / Supabase / свой сервер)
# Пример:
# DATABASE_URL=postgresql://user:password@host:5432/booking
DATABASE_URL=

# Пароль администратора. Используется ОДИН раз — при первом запуске init_db.py.
# Если не задан, генерируется случайный и печатается в консоли.
ADMIN_PASSWORD=1111
