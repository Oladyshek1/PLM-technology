/* Универсальный спиннер — один для всего проекта */
.spinner {
  width: 24px;
  height: 24px;
  border: 3px solid #E0E7FF;       /* светлый фон-кольцо */
  border-top: 3px solid #2563EB;   /* синяя дуга */
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

/* Три размера */
.spinner--s { width: 16px; height: 16px; border-width: 2px; }
.spinner--m { width: 32px; height: 32px; border-width: 3px; }
.spinner--l { width: 48px; height: 48px; border-width: 4px; }

@keyframes spin {
  0%   { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* Контейнер для спиннера по центру страницы */
.spinner-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 40px;
  color: #6B7280;
  font-size: 14px;
}

/* Кнопка со спиннером */
.btn--loading {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  pointer-events: none;   /* блокирует клики */
  opacity: 0.7;
}